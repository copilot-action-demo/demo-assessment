{
  "name": "demo-assessment",
  "version": "1.0.0",
  "description": "GitHub Copilot code-review assistant extension",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --coverage --coverageDirectory=coverage --passWithNoTests",
    "test:node": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@copilot-extensions/preview-sdk": "^5.0.1",
    "express": "^4.19.2",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/express": "^4.17.21",
    "babel-jest": "^30.4.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "coverageDirectory": "coverage",
    "transform": {
      "^.+\\.js$": "babel-jest"
    }
  }
}